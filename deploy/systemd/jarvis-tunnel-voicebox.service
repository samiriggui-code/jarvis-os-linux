[Unit]
Description=JARVIS — tunnel sortant NUC → VPS pour voicebox (127.0.0.1:17600)
After=network-online.target
Wants=network-online.target
Before=jarvis-core.service
PartOf=jarvis.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Clé DÉDIÉE, sans passphrase, restreinte côté VPS à ce seul usage :
#   restrict,port-forwarding,permitopen="127.0.0.1:17600",command="/bin/false"
# Même modèle que jarvis-tunnel-ollama (port 11435).
#
# ExitOnForwardFailure : sans lui, ssh reste « actif » alors que le bind a
# échoué — panne silencieuse.
ExecStart=/usr/bin/ssh -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ConnectTimeout=15 \
    -o StrictHostKeyChecking=yes \
    -o BatchMode=yes \
    -i /root/.ssh/jarvis_vps_voicebox_ed25519 \
    -L 127.0.0.1:17600:127.0.0.1:17600 \
    root@187.77.166.124
Restart=always
RestartSec=10

[Install]
WantedBy=jarvis.target
