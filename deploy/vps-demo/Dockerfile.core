# Core JARVIS — démo VPS (WS + Claude + ElevenLabs). Sans HA / Pi / wake.
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Déps minimales démo (pas mediapipe / wake / agent-reach git)
COPY deploy/vps-demo/requirements-core-demo.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY core/ /app/core/
WORKDIR /app/core

ENV PYTHONUNBUFFERED=1 \
    JARVIS_WS_HOST=0.0.0.0 \
    JARVIS_WS_PORT=8765 \
    JARVIS_VOICEBOX_TTS=0 \
    JARVIS_ELEVENLABS_FALLBACK=1

EXPOSE 8765
CMD ["python", "-m", "jarvis_core"]
