# Copier vers /etc/jarvis/hermes.env (chmod 600) — hors git.
# Fusion possible dans secrets.env ; ce fichier isole Hermes.

HERMES_HOME=/var/lib/jarvis/hermes

# API HTTP locale (Core → JARVIS_HERMES_URL=http://127.0.0.1:8642)
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# ⚠ CETTE CLÉ COMMANDE L'EXISTENCE MÊME DE L'API.
# Hermes n'enrôle la plateforme `api_server` que si la clé passe
# `has_usable_secret(min_length=16)` — gateway/config.py. En dessous de 16
# caractères, ou avec un placeholder connu, la gateway démarre normalement,
# systemd affiche « active (running) », et personne n'écoute sur 8642.
# `API_SERVER_ENABLED=true` seul ne suffit PAS.
#
# Générer :  openssl rand -hex 32
API_SERVER_KEY=

# Optionnel — chemin du binaire si hors .venv standard
# HERMES_BIN=/opt/jarvis/hermes-agent/.venv/bin/hermes
# HERMES_WORKDIR=/opt/jarvis/hermes-agent
