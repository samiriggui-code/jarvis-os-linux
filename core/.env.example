# Copier vers core/.env (jamais committer .env)
# Prod — chaîne LLM : Ollama VPS → OpenRouter → mode système

# LLM #1 — Ollama sur le VPS (via tunnel / VPN)
JARVIS_REMOTE_LLM_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b

# LLM #2 — OpenRouter (agents lourds / secours)
OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
# JARVIS_OPENROUTER_BASE=https://openrouter.ai/api/v1

# Optionnel — forcer mode sans LLM
# JARVIS_FORCE_SYSTEM=1

# PostgreSQL (prod) — SQLAlchemy + Alembic
# JARVIS_DATABASE_URL=postgresql+psycopg://jarvis:CHANGE_ME@127.0.0.1:5432/jarvis
# Sans URL → SQLite fallback core/data/jarvis.db (dev local)
# Migrations : cd core && alembic upgrade head

# Hermes (requis dès le 1er chat) — service : jarvis-hermes / alias hermes-agent
# JARVIS_HERMES_URL=http://127.0.0.1:8642
#
# Clé de l'API d'Hermes. SANS ELLE, LE PONT NE FAIT RIEN : l'API répond 401 à
# tout — sans en-tête, avec un `Bearer` vide comme avec une clé fausse (vérifié).
# Le Core le dit alors explicitement au lieu d'échouer en silence.
#
# La valeur est celle d'`API_SERVER_KEY` dans /etc/jarvis/hermes.env sur le NUC
# (chmod 600, hors dépôt). Ne jamais la coller ici : ce fichier est versionné.
#
#   ssh jarvis-nuc 'grep API_SERVER_KEY /etc/jarvis/hermes.env'
#
# Hermes n'écoute qu'en loopback sur le NUC. Un Core lancé ailleurs (portable en
# développement) a donc besoin du tunnel avant que la clé serve à quoi que ce soit :
#
#   ssh -N -L 8642:127.0.0.1:8642 jarvis-nuc
#
# JARVIS_HERMES_KEY=

# Home Assistant — adaptateur DIRECT du Core, sans agent ni LLM.
# Contrat : `Core → Home Assistant Adapter → HA API` (JARVIS-Satellites.md), et
# cahier des charges §11 « Mode 3, sans LLM : le Core continue (HA, Plex…) ».
# Mesuré : 207 ms d'inventaire puis ~0 ms par commande, contre 475 s en passant
# par Hermes. Une lampe ne se pilote pas par inférence.
# Le jeton longue durée vit dans /etc/jarvis/hermes.env sur le NUC — jamais ici.
# JARVIS_HASS_URL=http://192.168.1.27:8123
# JARVIS_HASS_TOKEN=

# Satellite salon (Pi) — enceintes jack via jarvis-ear (HTTP).
# JARVIS_SALON_SPEAKER_URL=http://192.168.1.27:8767
# Ingest Pi → Core (loopback ; nginx proxifie /v1/salon/ depuis le LAN).
# JARVIS_SALON_INGEST_HOST=127.0.0.1
# JARVIS_SALON_INGEST_PORT=8766
# Freebox Player via Pi (/v1/player.json) — même URL speaker.
# JARVIS_SALON_CAM_URL=http://192.168.1.27:8768/stream.mjpg
# Optionnel : Bearer partagé avec jarvis-ear (JARVIS_SALON_TOKEN).
# JARVIS_SALON_TOKEN=

# Plex — même logique, le §11 le nomme au même titre que HA.
# L'adresse est explicite : le ProLiant s'annonce sur deux cartes (.44 et .57),
# et laisser Plex choisir ferait dépendre le chemin vidéo de l'ordre de
# découverte. Le jeton vit dans /etc/jarvis/plex.env sur le NUC — jamais ici.
# JARVIS_PLEX_URL=http://192.168.1.44:32400
# JARVIS_PLEX_TOKEN=

# Mission Control DEV — racine des workspaces (DB projects + disque réel).
# Sur PC Windows / Laragon : C:\laragon\www
# Sur NUC Linux : chemin local ou partage monté (le Core NUC n'écrit PAS
# tout seul sur le C: du laptop sans agent / Samba).
# JARVIS_PROJECTS_ROOT=C:\laragon\www
# JARVIS_PROJECTS_ROOT=/var/lib/jarvis/projects

# adb, pour le player Free du salon uniquement. Absent du NUC à ce jour : le
# back-end salon échoue alors en le disant, au lieu de faire semblant.
# JARVIS_ADB=adb

# JARVIS_HERMES_URL=http://127.0.0.1:8642
# JARVIS_HERMES_KEY=
# Délai SSE runs Hermes (secondes) — défaut 120 ; anciennement 45 (coupures fréquentes).
# JARVIS_HERMES_TIMEOUT=120
#
# MCP slim (pattern agent-swarm) — réduit les toolsets visibles par Hermes :
# JARVIS_HERMES_SKILLS_ONLY=1          # chat foyer : skills uniquement (admin inclus)
# JARVIS_HERMES_SLIM_TOOLSETS=skills   # défaut ; liste CSV si plusieurs toolsets
# JARVIS_HERMES_TOOLSETS=spotify,web   # allowlist explicite (sans skills-only)

# Spotify via Hermes — 1/true/yes + toolset spotify côté Hermes + credentials Spotify Hermes
# JARVIS_SPOTIFY_ENABLED=0

# Home Assistant (domotique Core, sans LLM)
# JARVIS_HASS_URL=http://192.168.1.27:8123
# JARVIS_HASS_TOKEN=

# --- Voix (voicebox) — service séparé, jamais monté dans le Core -------------
# JARVIS_VOICEBOX_URL=http://127.0.0.1:17600
# JARVIS_VOICEBOX_TIMEOUT=60
# 0 = Voicebox excluded from live TTS routing (prod nominal : ElevenLabs)
# 1 = Voicebox TTS enabled (benchmark / GPU / expérimental)
JARVIS_VOICEBOX_TTS=0
# JARVIS_VOICEBOX_PROFILE_JARVIS=jarvis3
# JARVIS_VOICEBOX_PROFILE_FR=jarvis-fr
# JARVIS_VOICEBOX_PROFILE_EN=jarvis-en
# JARVIS_VOICEBOX_PROFILE_SOFT=jarvis-soft
# JARVIS_VOICEBOX_PROFILE_CLAUDE=jarvis
# JARVIS_VOICEBOX_PROFILE_CURSOR=jarvis2
# JARVIS_VOICEBOX_PROFILE_HERMES=hermes

# TTS cloud — cache vocal + hors domicile (tél / portable web)
ELEVENLABS_API_KEY=
# Instructions opérateur optionnelles (complètent Personality — ne remplacent pas)
# JARVIS_OPERATOR_PROMPT=
# Legacy alias : JARVIS_SYSTEM_PROMPT (même rôle que OPERATOR)
# Voix multi-entity (ElevenLabs) — override optionnel ; défaut registre Core
# JARVIS_ELEVENLABS_VOICE_JARVIS=HhLkLX9WkAwlzDXzuHzd
# JARVIS_ELEVENLABS_VOICE_CLAUDE=F42eFqrXBZYrTDYwcHo0
# JARVIS_ELEVENLABS_VOICE_CURSOR=Z5gdl1qPL2yS8NNiW921
# JARVIS_ELEVENLABS_VOICE_HERMES=HuLbOdhRlvQQN8oPP0AJ

# --- Workspaces Mission DEV / P5 (cf. docs/architecture/JARVIS-WORKSPACES.md) -
# V2 (NUC) : authoritative device uniquement — PAS de chemins Windows ici
# JARVIS_MAIN_DEVICE_ID=pc-33a88e343339
# V1 compat (Core sur la même machine que le repo) — éviter en prod NUC :
# JARVIS_WORKSPACE_LEGACY_CORE_PATH=1
# JARVIS_MAIN_LOCAL_PATH=C:\laragon\www\jarvis-os-linux
# Chemins Windows → Windows Agent (%ProgramData%\JARVIS\agent.env) :
# JARVIS_WORKSPACE_ROOT=C:\laragon\www
# JARVIS_MAIN_LOCAL_PATH=C:\laragon\www\jarvis-os-linux

# --- Device agents (P4) — app.launch via agent local -------------------------
# JARVIS_DEVICE_AGENT_ENABLED=1
# JARVIS_DEVICE_EXECUTE_TIMEOUT_S=30
# JARVIS_DEVICE_TTL_S=120

# --- Terminal admin Dashboard — VPS / Pi salon (remote_exec.py) --------------
# Clé dédiée par cible, générée SUR LE NUC (jamais réutiliser les clés perso
# du poste de dev) — cf. plan Terminal admin, section T2 :
#   ssh-keygen -t ed25519 -f /etc/jarvis/ssh/vps_terminal -N ""
#   ssh-keygen -t ed25519 -f /etc/jarvis/ssh/pi_terminal -N ""
# Puis déposer la clé publique dans authorized_keys de la cible, avec
# `restrict,command="..."` (wrapper qui revalide l'allowlist côté cible).
# Sans ces 3 variables, `remote_exec.run()` répond une erreur explicite —
# jamais une tentative de connexion silencieuse.
# JARVIS_VPS_SSH_HOST=
# JARVIS_VPS_SSH_USER=jarvis
# JARVIS_VPS_SSH_KEY=/etc/jarvis/ssh/vps_terminal
# JARVIS_PI_SSH_HOST=192.168.1.27
# JARVIS_PI_SSH_USER=jarvis
# JARVIS_PI_SSH_KEY=/etc/jarvis/ssh/pi_terminal
